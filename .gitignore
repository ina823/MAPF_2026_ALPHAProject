# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments (keep them outside the repository if possible)
.venv/
.venv-*/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Model / data files: nothing is tracked unless whitelisted explicitly
*.pt
*.npz
